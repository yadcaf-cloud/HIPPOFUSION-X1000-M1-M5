
"""HIPPOFUSION X1000 M1-M5 — Publication sécurisée.

Lit audit_latest.json et produit publication_latest.json.
Ne modifie jamais les fichiers PV et FIGÉS historiques.
"""

import json
import os
import tempfile
from pathlib import Path

DATA_DIR = Path(__file__).resolve().parent / "data"
MOTEURS = ("M1", "M2", "M3", "M4", "M5")


def publier(data_dir=DATA_DIR):
    data_dir = Path(data_dir)
    source = data_dir / "audit_latest.json"
    cible = data_dir / "publication_latest.json"

    if not source.is_file():
        print("ERREUR : audit_latest.json introuvable.")
        return None

    try:
        audit = json.loads(source.read_text(encoding="utf-8"))

        if not isinstance(audit, dict):
            raise ValueError("Audit invalide.")

        donnees = audit.get("courses", [])

        if not isinstance(donnees, list):
            raise ValueError("courses doit être une liste.")

        publication_courses = []
        identifiants = set()

        for course in donnees:
            if not isinstance(course, dict):
                raise ValueError("Course invalide.")

            identifiant = course.get("id")

            if not isinstance(identifiant, str):
                continue

            identifiant = identifiant.strip()

            if not identifiant:
                continue

            if identifiant in identifiants:
                raise ValueError(
                    f"Course en double : {identifiant}"
                )

            identifiants.add(identifiant)

            moteurs = course.get("moteurs", {})

            if not isinstance(moteurs, dict):
                raise ValueError(
                    f"Moteurs invalides : {identifiant}"
                )

            for moteur in moteurs:
                if moteur not in MOTEURS:
                    raise ValueError(
                        f"Moteur inconnu : {moteur}"
                    )

            publication_courses.append({
                "id": identifiant,
                "hippodrome": course.get("hippodrome"),
                "depart": course.get("depart"),
                "partants": course.get("partants"),
                "non_partants": course.get("non_partants"),
                "source": course.get("source"),
                "statut": course.get("statut"),
                "analyse_a": course.get("analyse_a"),
                "fichier_fige": course.get("fichier_fige"),
                "moteurs": moteurs
            })

        publication = {
            "logiciel": "HIPPOFUSION X1000 M1-M5",
            "date": audit.get("date"),
            "genere_a": audit.get("genere_a"),
            "statut_collecte": audit.get("statut_collecte"),
            "courses": publication_courses,
            "avertissement": [
                "Les analyses ne garantissent aucun gain.",
                "Les PV et FIGÉS historiques sont préservés.",
                "Une analyse provisoire n'est pas un FIGÉ."
            ]
        }

        data_dir.mkdir(parents=True, exist_ok=True)

        temporaire = None

        try:
            with tempfile.NamedTemporaryFile(
                mode="w",
                encoding="utf-8",
                dir=data_dir,
                prefix=".publication_",
                suffix=".tmp",
                delete=False
            ) as fichier:

                temporaire = Path(fichier.name)

                json.dump(
                    publication,
                    fichier,
                    ensure_ascii=False,
                    indent=2,
                    allow_nan=False
                )

                fichier.write("\n")
                fichier.flush()
                os.fsync(fichier.fileno())

            os.replace(temporaire, cible)

        finally:
            if temporaire is not None:
                temporaire.unlink(missing_ok=True)

        print("HIPPOFUSION X1000 — Publication réussie.")
        print(f"Courses publiées : {len(publication_courses)}")
        print(f"Fichier : {cible}")

        return cible

    except (OSError, ValueError, TypeError) as erreur:
        print(f"ERREUR : publication impossible : {erreur}")
        return None


# Compatibilité avec main.py et les anciens appels.
publish = publier


if __name__ == "__main__":
    resultat = publier()

    if resultat is None:
        raise SystemExit(1)
