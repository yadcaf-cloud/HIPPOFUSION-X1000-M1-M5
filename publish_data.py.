"""HIPPOFUSION X1000 M1-M5 — Publication sécurisée.

Lit data/audit_latest.json et écrit data/publication_latest.json.
Ne modifie aucun PV ni FIGÉ historique.
"""

import json
import os
import tempfile
from pathlib import Path

DATA_DIR = Path(__file__).resolve().parent / "data"
MOTEURS = ("M1", "M2", "M3", "M4", "M5")


def _moteurs_valides(valeur):
    """Conserve les moteurs connus, sans inventer de prédictions."""
    if valeur is None:
        return {}
    if isinstance(valeur, dict):
        return {nom: valeur[nom] for nom in MOTEURS if nom in valeur}
    if isinstance(valeur, list):
        resultat = {}
        for element in valeur:
            if isinstance(element, dict):
                nom = element.get("moteur", element.get("nom"))
                if nom in MOTEURS and nom not in resultat:
                    resultat[nom] = element
        return resultat
    raise ValueError("Le champ moteurs doit être un objet ou une liste.")


def publier(data_dir=DATA_DIR):
    """Publie l'audit de manière atomique; renvoie le chemin ou None."""
    data_dir = Path(data_dir)
    source = data_dir / "audit_latest.json"
    cible = data_dir / "publication_latest.json"
    temporaire = None

    try:
        if not source.is_file():
            raise FileNotFoundError(f"Audit introuvable : {source}")

        audit = json.loads(source.read_text(encoding="utf-8"))
        if not isinstance(audit, dict):
            raise ValueError("L'audit doit être un objet JSON.")
        donnees = audit.get("courses", [])
        if not isinstance(donnees, list):
            raise ValueError("Le champ courses doit être une liste.")

        courses = []
        identifiants = set()
        for index, course in enumerate(donnees, start=1):
            if not isinstance(course, dict):
                raise ValueError(f"Course {index} : objet JSON attendu.")
            identifiant = course.get("id")
            if not isinstance(identifiant, str) or not identifiant.strip():
                raise ValueError(f"Course {index} : identifiant manquant.")
            identifiant = identifiant.strip()
            if identifiant in identifiants:
                raise ValueError(f"Identifiant de course en double : {identifiant}")
            identifiants.add(identifiant)

            statut = course.get("statut")
            # Ne jamais fabriquer de FIGÉ à partir d'une analyse provisoire.
            if statut is not None and not isinstance(statut, str):
                raise ValueError(f"Course {identifiant} : statut invalide.")
            moteurs = _moteurs_valides(course.get("moteurs"))
            courses.append({
                "id": identifiant,
                "hippodrome": course.get("hippodrome"),
                "depart": course.get("depart"),
                "partants": course.get("partants"),
                "non_partants": course.get("non_partants", []),
                "source": course.get("source"),
                "statut": statut,
                "analyse_a": course.get("analyse_a"),
                "fichier_fige": course.get("fichier_fige"),
                "moteurs": moteurs,
            })

        publication = {
            "logiciel": "HIPPOFUSION X1000 M1-M5",
            "date": audit.get("date"),
            "genere_a": audit.get("genere_a"),
            "statut_collecte": audit.get("statut_collecte"),
            "courses": courses,
            "avertissement": [
                "Les analyses ne garantissent aucun gain.",
                "Les PV et FIGÉS historiques sont préservés.",
                "Une analyse provisoire n'est pas un FIGÉ.",
            ],
        }

        data_dir.mkdir(parents=True, exist_ok=True)
        with tempfile.NamedTemporaryFile(
            mode="w", encoding="utf-8", dir=data_dir,
            prefix=".publication_", suffix=".tmp", delete=False
        ) as fichier:
            temporaire = Path(fichier.name)
            json.dump(publication, fichier, ensure_ascii=False, indent=2, allow_nan=False)
            fichier.write("\n")
            fichier.flush()
            os.fsync(fichier.fileno())
        os.replace(temporaire, cible)
        print(f"HIPPOFUSION X1000 — Publication réussie : {len(courses)} course(s)")
        print(f"Fichier : {cible}")
        return cible
    except (OSError, ValueError, TypeError, json.JSONDecodeError) as erreur:
        print(f"ERREUR : publication impossible : {erreur}")
        return None
    finally:
        if temporaire is not None:
            temporaire.unlink(missing_ok=True)


# Compatibilité avec les anciens appels et main.py.
publish = publier

if __name__ == "__main__":
    if publier() is None:
        raise SystemExit(1)
