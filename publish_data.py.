
"""HIPPOFUSION X1000 M1-M5 — Publication sécurisée.

Lit le dernier audit et publie les données validées.
Préserve les références PV et FIGÉ.
Ne modifie jamais les fichiers historiques.
"""

import json
import os
import tempfile
from datetime import datetime
from pathlib import Path
from zoneinfo import ZoneInfo

DATA_DIR = Path(__file__).resolve().parent / "data"
MOTEURS = ("M1", "M2", "M3", "M4", "M5")


def publier(data_dir=DATA_DIR):
    data_dir = Path(data_dir)
    source = data_dir / "audit_latest.json"
    cible = data_dir / "publication_latest.json"

    if not source.is_file():
        print("ERREUR : audit_latest.json introuvable.")
        return None

    try:
        audit = json.loads(source.read_text(encoding="utf-8"))
    except (OSError, ValueError) as erreur:
        print(f"ERREUR : lecture de l'audit : {erreur}")
        return None

    if not isinstance(audit, dict):
        print("ERREUR : audit invalide.")
        return None

    courses = audit.get("courses", [])

    if not isinstance(courses, list):
        print("ERREUR : courses doit être une liste.")
        return None

    publication_courses = []
    identifiants = set()

    for position, course in enumerate(courses, start=1):
        if not isinstance(course, dict):
            print(f"ERREUR : course {position} invalide.")
            return None

        identifiant = course.get("id")

        if not isinstance(identifiant, str) or not identifiant.strip():
            print(f"ERREUR : identifiant manquant, course {position}.")
            return None

        if identifiant in identifiants:
            print(f"ERREUR : course en double : {identifiant}")
            return None

        identifiants.add(identifiant)

        moteurs = course.get("moteurs", {})

        if not isinstance(moteurs, dict):
            print(f"ERREUR : moteurs invalides : {identifiant}")
            return None

        # Copie complète pour conserver les champs existants.
        nouvelle_course = dict(course)

        # Les moteurs M1 à M5 restent indépendants.
        # Les autres champs de la course sont préservés.
        nouvelle_course["moteurs"] = {
            nom: moteurs[nom]
            for nom in MOTEURS
            if nom in moteurs
        }

        publication_courses.append(nouvelle_course)

    publication = {
        "logiciel": "HIPPOFUSION X1000",
        "architecture": "M1-M5",
        "date": audit.get("date"),
        "genere_a": audit.get("genere_a"),
        "publie_a": datetime.now(
            ZoneInfo("Europe/Paris")
        ).isoformat(),
        "statut_collecte": audit.get("statut_collecte"),
        "nombre_courses": len(publication_courses),
        "courses": publication_courses,
        "avertissement": [
            "Les analyses hippiques ne garantissent aucun gain.",
            "Les PV et FIGÉS historiques ne sont jamais modifiés."
        ]
    }

    # Préserver les autres informations générales de l'audit.
    for cle, valeur in audit.items():
        if cle not in publication:
            publication[cle] = valeur

    temporaire = None

    try:
        data_dir.mkdir(parents=True, exist_ok=True)

        with tempfile.NamedTemporaryFile(
            mode="w",
            encoding="utf-8",
            dir=data_dir,
            prefix=".publication_",
            suffix=".tmp",
            delete=False
        ) as fichier:
            temporaire = Path(fichier.name)
            json.dump(
                publication,
                fichier,
                ensure_ascii=False,
                indent=2,
                allow_nan=False
            )
            fichier.write("\n")
            fichier.flush()
            os.fsync(fichier.fileno())

        # Remplacement atomique du fichier de publication.
        os.replace(temporaire, cible)

    except (OSError, ValueError, TypeError) as erreur:
        print(f"ERREUR : publication impossible : {erreur}")
        return None

    finally:
        if temporaire is not None:
            temporaire.unlink(missing_ok=True)

    print("HIPPOFUSION X1000 — Publication réussie.")
    print(f"Courses publiées : {len(publication_courses)}")
    print(f"Fichier : {cible}")

    return cible


# Compatibilité avec les anciens appels.
publish = publier


if __name__ == "__main__":
    resultat = publier()
    if resultat is None:
        raise SystemExit(1)
